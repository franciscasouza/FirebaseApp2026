{
    "name": "Flutter Dev Container",
    "image": "ghcr.io/cirruslabs/flutter:stable",
    "features": {
        "ghcr.io/devcontainers/features/git-lfs": {
            "version": "1"
        }
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "Dart-Code.dart-code",
                "Dart-Code.flutter"
            ]
        }
    },
    "forwardPorts": [8080],
    "postCreateCommand": "flutter doctor && git lfs install"
}